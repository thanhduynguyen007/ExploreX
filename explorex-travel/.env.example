# App
NEXT_PUBLIC_APP_NAME="ExploreX Travel"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
# Change this in local/production. Do not reuse this example value for deployment.
JWT_SECRET="dev-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"

# Set to false to require a real MySQL database for login.
# When omitted or true, auth can fall back to demo accounts if the database is unavailable.
AUTH_USE_MOCK="false"

# MySQL
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="crebas5"

# VNPAY
# Leave code/secret empty to use the internal demo payment fallback.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_PATH="/api/payments/vnpay/return"
VNPAY_ORDER_TYPE="other"
VNPAY_LOCALE="vn"
